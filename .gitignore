# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# byte compiled
__pycache__/
*.py[cod]

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ------------------------------------------------------------------
# Project-specific
# ------------------------------------------------------------------

# byte compiled
__pycache__/
*.py[cod]

# Unity player builds used for training
/ML/*build*/
/ML/*builds/

# Training outputs and checkpoints (final models are whitelisted)
/ML/logs/
/ML/models/*
!/ML/models/cnn_models/
!/ML/models/cnn_weights/
/ML/models/cnn_weights/*
!/ML/models/cnn_weights/cnn_green_4conv_d.pth
!/ML/models/last_archive/
/ML/models/last_archive/*
!/ML/models/last_archive/circle_drift_cnn_28.zip
!/ML/models/last_archive/drift_circle_10_60.zip
!/ML/models/last_archive/formula_drift_50.zip
!/ML/models/last_archive/german_drive_cnn_230.zip
!/ML/models/last_archive/german_drive_full_sim_info_190.zip
mprofile_*.dat

# Raw drive logs (processed versions live in analysis/compute_logs)
/analysis/drive_logs/

# ML-Agents runtime timers
/[Aa]ssets/ML-Agents/

# ROS 2 / colcon build outputs and raw recordings
/ros/ros2_ws/build/
/ros/ros2_ws/install/
/ros/ros2_ws/log/
**/recordings/

# OS / editor
.DS_Store
.ipynb_checkpoints/
